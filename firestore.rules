rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token.email in ['goferconstruction@gmail.com', 'yaredcotm@gmail.com', 'admin@teklesawiros.org'] && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isAdmin() {
      return isSuperAdmin();
    }

    function isDeptAdmin(deptId) {
      return isSuperAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/department_memberships/$(request.auth.uid + '_' + deptId)) &&
        get(/databases/$(database)/documents/department_memberships/$(request.auth.uid + '_' + deptId)).data.role == 'ADMIN' &&
        get(/databases/$(database)/documents/department_memberships/$(request.auth.uid + '_' + deptId)).data.status == 'APPROVED'
      );
    }

    function isReviewer() {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['REVIEWER', 'ADMIN', 'SUPER_ADMIN']
      );
    }

    // 1. Connection test doc
    match /test/{docId} {
      allow read: if true;
    }

    // 2. Admins collection
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(adminId);
    }

    // 3. User Profiles collection
    function isValidUserProfile(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 150 &&
             data.email is string && data.email.size() <= 150 &&
             data.role in ['MEMBER', 'CONTRIBUTOR', 'REVIEWER', 'EDITOR', 'ADMIN', 'SUPER_ADMIN'] &&
             (!('department' in data) || (data.department is string && data.department.size() <= 150)) &&
             (!('joinedDate' in data) || (data.joinedDate is string && data.joinedDate.size() <= 50)) &&
             (!('bookmarks' in data) || (data.bookmarks is list && data.bookmarks.size() <= 500));
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().role in ['MEMBER', 'CONTRIBUTOR'];
      allow update: if isValidId(userId) && isValidUserProfile(incoming()) && (
        (isOwner(userId) && incoming().id == existing().id && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'department', 'bookmarks'])) ||
        (isAdmin() && incoming().id == existing().id)
      );
      allow delete: if isAdmin();
    }

    // 4. Church Members collection (Roster of writers, organizers, presenters)
    function isValidMember(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 150 &&
             data.duty in ['WRITER', 'ORGANIZER', 'PRESENTER'] &&
             data.department is string && data.department.size() <= 150 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('spiritualTitle' in data) || (data.spiritualTitle is string && data.spiritualTitle.size() <= 100)) &&
             (!('joinedYear' in data) || (data.joinedYear is string && data.joinedYear.size() <= 30)) &&
             (!('assignedWorksCount' in data) || (data.assignedWorksCount is number)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 1000));
    }

    match /members/{memberId} {
      allow get, list: if true;
      allow create: if (isAdmin() || isReviewer()) && isValidId(memberId) && isValidMember(incoming());
      allow update: if (isAdmin() || isReviewer()) && isValidId(memberId) && isValidMember(incoming()) && incoming().id == existing().id;
      allow delete: if isAdmin() && isValidId(memberId);
    }

    // 5. Cultural Events collection (Church programs and festivals)
    function isValidEvent(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.recurrence in ['WEEKLY', 'MONTHLY', 'YEARLY', 'SPECIAL'] &&
             data.location is string && data.location.size() <= 200 &&
             data.organizer is string && data.organizer.size() <= 150 &&
             (!('dateAmharic' in data) || (data.dateAmharic is string && data.dateAmharic.size() <= 100)) &&
             (!('timeAmharic' in data) || (data.timeAmharic is string && data.timeAmharic.size() <= 100)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 100)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
             (!('division' in data) || data.division == null || (data.division is string && data.division.size() <= 50)) &&
             (!('assignments' in data) || (data.assignments is list && data.assignments.size() <= 50));
    }

    match /events/{eventId} {
      allow get, list: if true;
      allow create: if (isAdmin() || isReviewer()) && isValidId(eventId) && isValidEvent(incoming());
      allow update: if (isAdmin() || isReviewer()) && isValidId(eventId) && isValidEvent(incoming()) && incoming().id == existing().id;
      allow delete: if isAdmin() && isValidId(eventId);
    }

    // 6. Works collection (Poems, literature, theater, scripts, artwork)
    function isValidWork(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
             data.writerId is string && data.writerId.size() <= 128 &&
             data.categoryId is string && data.categoryId.size() <= 50 &&
             data.content is string && data.content.size() <= 50000 &&
             data.status in ['DRAFT', 'UNDER_REVIEW', 'APPROVED', 'REVISION_REQUESTED', 'REJECTED'] &&
             data.division in ['children', 'intermediates', 'youth'] &&
             (!('writerName' in data) || (data.writerName is string && data.writerName.size() <= 150)) &&
             (!('categoryName' in data) || (data.categoryName is string && data.categoryName.size() <= 100)) &&
             (!('dateAmharic' in data) || (data.dateAmharic is string && data.dateAmharic.size() <= 50)) &&
             (!('excerpt' in data) || (data.excerpt is string && data.excerpt.size() <= 500)) &&
             (!('readTime' in data) || (data.readTime is string && data.readTime.size() <= 30)) &&
             (!('version' in data) || (data.version is number)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 30)) &&
             (!('isFeatured' in data) || (data.isFeatured is bool)) &&
             (!('approvedBy' in data) || (data.approvedBy is string && data.approvedBy.size() <= 150)) &&
             (!('approvedDate' in data) || (data.approvedDate is string && data.approvedDate.size() <= 50)) &&
             (!('reviewerFeedback' in data) || (data.reviewerFeedback is string && data.reviewerFeedback.size() <= 2000)) &&
             (!('hasPdfAttachment' in data) || (data.hasPdfAttachment is bool)) &&
             (!('pdfFileName' in data) || (data.pdfFileName is string && data.pdfFileName.size() <= 255)) &&
             (!('pdfFileSize' in data) || (data.pdfFileSize is string && data.pdfFileSize.size() <= 50)) &&
             (!('pdfUrl' in data) || (data.pdfUrl is string && data.pdfUrl.size() <= 1000));
    }

    match /works/{workId} {
      // Anyone can read and list works in the public cultural archive
      allow get, list: if true;

      // Create: Authenticated users can submit their own works under review or draft
      allow create: if isSignedIn() &&
                    isValidId(workId) &&
                    isValidWork(incoming()) &&
                    incoming().writerId == request.auth.uid &&
                    (incoming().status in ['DRAFT', 'UNDER_REVIEW'] || isAdmin());

      // Update:
      // Authors can update content/title of their own works in draft/under review
      // Reviewers/Admins can update status, feedback, approvedBy, etc.
      allow update: if isSignedIn() &&
                    isValidId(workId) &&
                    isValidWork(incoming()) &&
                    incoming().id == existing().id &&
                    incoming().writerId == existing().writerId && (
                      isAdmin() ||
                      (isReviewer() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewerFeedback', 'approvedBy', 'approvedDate', 'isFeatured', 'version', 'updatedAt'])) ||
                      (isOwner(existing().writerId) && existing().status in ['DRAFT', 'UNDER_REVIEW', 'REVISION_REQUESTED'] &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'excerpt', 'tags', 'hasPdfAttachment', 'pdfFileName', 'pdfFileSize', 'pdfUrl', 'version', 'status', 'division', 'categoryId', 'categoryName', 'updatedAt']) &&
                       incoming().status in ['DRAFT', 'UNDER_REVIEW'])
                    );

      // Delete: Author (if draft) or Admin
      allow delete: if isValidId(workId) && (isAdmin() || (isOwner(resource.data.writerId) && resource.data.status == 'DRAFT'));
    }

    // 7. Departments collection
    match /departments/{deptId} {
      allow get, list: if true;
      allow create, update, delete: if isSuperAdmin() && isValidId(deptId);
    }

    // 8. Department Memberships (Requests & Approvals)
    function isValidMembership(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.userEmail is string && data.userEmail.size() <= 150 &&
             data.userName is string && data.userName.size() <= 150 &&
             data.departmentId is string && data.departmentId.size() <= 64 &&
             data.role in ['MEMBER', 'CONTRIBUTOR', 'REVIEWER', 'EDITOR', 'ADMIN'] &&
             data.status in ['PENDING', 'APPROVED', 'REJECTED', 'SUSPENDED'];
    }

    match /department_memberships/{membershipId} {
      // Users can read their own membership; department admins can read their department members; super admins can read all
      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isDeptAdmin(resource.data.departmentId) ||
        isSuperAdmin()
      );
      allow list: if isSignedIn();

      // Creation: Any signed-in user can create a PENDING membership for themselves with standard role (not ADMIN)
      allow create: if isSignedIn() &&
                    isValidId(membershipId) &&
                    isValidMembership(incoming()) && (
                      (incoming().userId == request.auth.uid && incoming().status == 'PENDING' && incoming().role in ['MEMBER', 'CONTRIBUTOR']) ||
                      isSuperAdmin()
                    );

      // Update:
      // - Pending applicant updating their own application
      // - Dept Admin or Super Admin approving/rejecting/suspending or updating role
      allow update: if isSignedIn() &&
                    isValidId(membershipId) &&
                    isValidMembership(incoming()) && (
                      (isOwner(existing().userId) && existing().status == 'PENDING' &&
                       incoming().id == existing().id && incoming().userId == existing().userId &&
                       incoming().status == 'PENDING' && incoming().role in ['MEMBER', 'CONTRIBUTOR']) ||
                      (isDeptAdmin(existing().departmentId) &&
                       incoming().id == existing().id && incoming().userId == existing().userId &&
                       incoming().departmentId == existing().departmentId) ||
                      isSuperAdmin()
                    );

      allow delete: if isSuperAdmin() && isValidId(membershipId);
    }

    // 9. Schedule-based Task Assignments
    function isValidAssignment(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.departmentId is string && data.departmentId.size() <= 64 &&
             data.title is string && data.title.size() <= 250 &&
             data.responsibleLeadId is string && data.responsibleLeadId.size() <= 128 &&
             data.status in ['ASSIGNED', 'ACCEPTED', 'IN_PROGRESS', 'SUBMITTED', 'COMPLETED', 'REVISION_REQUESTED', 'CANCELLED'];
    }

    match /schedule_assignments/{assignmentId} {
      allow get, list: if isSignedIn();

      // Dept admin or Super Admin can create tasks for their department
      allow create: if isSignedIn() &&
                    isValidId(assignmentId) &&
                    isValidAssignment(incoming()) &&
                    (isDeptAdmin(incoming().departmentId) || isSuperAdmin());

      // Update:
      // - Dept Admin / Super Admin can perform any update
      // - Assigned members can accept, report progress, and submit work
      allow update: if isSignedIn() &&
                    isValidId(assignmentId) &&
                    isValidAssignment(incoming()) && (
                      isDeptAdmin(existing().departmentId) ||
                      isSuperAdmin() ||
                      (
                        request.auth.uid in existing().assignedMemberIds &&
                        incoming().departmentId == existing().departmentId &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'deliverableSubmission', 'individualParticipation', 'updatedAt']) &&
                        incoming().status in ['ACCEPTED', 'IN_PROGRESS', 'SUBMITTED']
                      )
                    );

      allow delete: if (isDeptAdmin(existing().departmentId) || isSuperAdmin()) && isValidId(assignmentId);
    }

    // 10. Department Notifications
    match /department_notifications/{notificationId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(notificationId);
      allow update: if isSignedIn() && isValidId(notificationId) && (
        resource.data.targetUserId == request.auth.uid ||
        isSuperAdmin()
      );
      allow delete: if isSuperAdmin() && isValidId(notificationId);
    }
  }
}
