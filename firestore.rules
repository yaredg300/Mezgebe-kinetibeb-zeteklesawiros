rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token.email in ['goferconstruction@gmail.com', 'finalizedyosef@gmail.com', 'yaredcotm@gmail.com', 'admin@teklesawiros.org'] && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isAdmin() {
      return isSuperAdmin();
    }

    function isApprovedMember(deptId) {
      return isSuperAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/department_memberships/$(request.auth.uid + '_' + deptId)) &&
        get(/databases/$(database)/documents/department_memberships/$(request.auth.uid + '_' + deptId)).data.status == 'APPROVED'
      );
    }

    function isDeptAdmin(deptId) {
      return isSuperAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/department_memberships/$(request.auth.uid + '_' + deptId)) &&
        get(/databases/$(database)/documents/department_memberships/$(request.auth.uid + '_' + deptId)).data.role == 'ADMIN' &&
        get(/databases/$(database)/documents/department_memberships/$(request.auth.uid + '_' + deptId)).data.status == 'APPROVED'
      );
    }

    function canAuthorizeMembers(deptId) {
      return isDeptAdmin(deptId) || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/department_memberships/$(request.auth.uid + '_' + deptId)) &&
        get(/databases/$(database)/documents/department_memberships/$(request.auth.uid + '_' + deptId)).data.status == 'APPROVED' &&
        ('canApproveMembers' in get(/databases/$(database)/documents/department_memberships/$(request.auth.uid + '_' + deptId)).data) &&
        get(/databases/$(database)/documents/department_memberships/$(request.auth.uid + '_' + deptId)).data.canApproveMembers == true
      );
    }

    function hasUnchangedApprovalAuthority(newData, oldData) {
      return ((!('canApproveMembers' in newData) && !('canApproveMembers' in oldData)) ||
              (!('canApproveMembers' in oldData) && ('canApproveMembers' in newData) && newData.canApproveMembers == false) ||
              (('canApproveMembers' in oldData) && !('canApproveMembers' in newData) && oldData.canApproveMembers == false) ||
              (('canApproveMembers' in newData) && ('canApproveMembers' in oldData) && newData.canApproveMembers == oldData.canApproveMembers));
    }

    function isReviewer() {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['REVIEWER', 'ADMIN', 'SUPER_ADMIN']
      );
    }

    // 1. Connection test doc
    match /test/{docId} {
      allow read: if true;
    }

    // 2. Admins collection
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(adminId);
    }

    // 3. User Profiles collection
    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'fullName', 'email', 'role']) &&
             data.keys().hasOnly([
               'id', 'fullName', 'email', 'role', 'department', 'departmentId',
               'sundaySchoolId', 'requestedPosition', 'joinedDate', 'bookmarks'
             ]) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 150 &&
             data.email is string && data.email.size() <= 150 &&
             data.role in ['MEMBER', 'CONTRIBUTOR', 'REVIEWER', 'EDITOR', 'ADMIN', 'SUPER_ADMIN'] &&
             (!('department' in data) || (data.department is string && data.department.size() <= 150)) &&
             (!('departmentId' in data) || (data.departmentId is string && data.departmentId.size() <= 64)) &&
             (!('sundaySchoolId' in data) || (data.sundaySchoolId is string && data.sundaySchoolId.size() > 0 && data.sundaySchoolId.size() <= 50)) &&
             (!('requestedPosition' in data) || data.requestedPosition in ['DEPARTMENT_HEAD', 'MIKITIL_HEAD', 'MEMBER']) &&
             (!('joinedDate' in data) || (data.joinedDate is string && data.joinedDate.size() <= 50)) &&
             (!('bookmarks' in data) || (data.bookmarks is list && data.bookmarks.size() <= 500));
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) &&
                    isValidId(userId) &&
                    isValidUserProfile(incoming()) &&
                    incoming().id == request.auth.uid &&
                    (incoming().role in ['MEMBER', 'CONTRIBUTOR'] || isSuperAdmin());
      allow update: if isValidId(userId) && isValidUserProfile(incoming()) && (
        (isOwner(userId) && incoming().id == existing().id && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'department', 'departmentId', 'sundaySchoolId', 'requestedPosition', 'bookmarks'])) ||
        (isAdmin() && incoming().id == existing().id)
      );
      allow delete: if isAdmin();
    }

    // 4. Church Members collection (Roster of writers, organizers, presenters)
    function isValidMember(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 150 &&
             data.duty in ['WRITER', 'ORGANIZER', 'PRESENTER'] &&
             data.department is string && data.department.size() <= 150 &&
             (!('departmentId' in data) || (data.departmentId is string && data.departmentId.size() <= 64)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('spiritualTitle' in data) || (data.spiritualTitle is string && data.spiritualTitle.size() <= 100)) &&
             (!('joinedYear' in data) || (data.joinedYear is string && data.joinedYear.size() <= 30)) &&
             (!('assignedWorksCount' in data) || (data.assignedWorksCount is number)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 1000));
    }

    match /members/{memberId} {
      allow get, list: if !('departmentId' in resource.data) || resource.data.departmentId == null || (
        isSignedIn() && (
          isSuperAdmin() ||
          isApprovedMember(resource.data.departmentId) ||
          canAuthorizeMembers(resource.data.departmentId)
        )
      );
      allow create: if (isAdmin() || (isSignedIn() && ('departmentId' in incoming()) && canAuthorizeMembers(incoming().departmentId))) && isValidId(memberId) && isValidMember(incoming());
      allow update: if (isAdmin() || (isSignedIn() && ('departmentId' in existing()) && canAuthorizeMembers(existing().departmentId) && incoming().departmentId == existing().departmentId)) && isValidId(memberId) && isValidMember(incoming()) && incoming().id == existing().id;
      allow delete: if (isAdmin() || (isSignedIn() && ('departmentId' in resource.data) && canAuthorizeMembers(resource.data.departmentId))) && isValidId(memberId);
    }

    // 5. Cultural Events collection (Church programs and festivals)
    function isValidEvent(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.recurrence in ['WEEKLY', 'MONTHLY', 'YEARLY', 'SPECIAL'] &&
             data.location is string && data.location.size() <= 200 &&
             data.organizer is string && data.organizer.size() <= 150 &&
             (!('departmentId' in data) || (data.departmentId is string && data.departmentId.size() <= 64)) &&
             (!('dateAmharic' in data) || (data.dateAmharic is string && data.dateAmharic.size() <= 100)) &&
             (!('timeAmharic' in data) || (data.timeAmharic is string && data.timeAmharic.size() <= 100)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 100)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
             (!('division' in data) || data.division == null || (data.division is string && data.division.size() <= 50)) &&
             (!('assignments' in data) || (data.assignments is list && data.assignments.size() <= 50));
    }

    match /events/{eventId} {
      allow get, list: if !('departmentId' in resource.data) || resource.data.departmentId == null || (
        isSignedIn() && (
          isSuperAdmin() ||
          isApprovedMember(resource.data.departmentId) ||
          canAuthorizeMembers(resource.data.departmentId)
        )
      );
      allow create: if (isAdmin() || (isSignedIn() && ('departmentId' in incoming()) && canAuthorizeMembers(incoming().departmentId))) && isValidId(eventId) && isValidEvent(incoming());
      allow update: if (isAdmin() || (isSignedIn() && ('departmentId' in existing()) && canAuthorizeMembers(existing().departmentId) && incoming().departmentId == existing().departmentId)) && isValidId(eventId) && isValidEvent(incoming()) && incoming().id == existing().id;
      allow delete: if (isAdmin() || (isSignedIn() && ('departmentId' in resource.data) && canAuthorizeMembers(resource.data.departmentId))) && isValidId(eventId);
    }

    // 6. Works collection (Poems, literature, theater, scripts, artwork)
    function isValidWork(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
             data.writerId is string && data.writerId.size() <= 128 &&
             data.categoryId is string && data.categoryId.size() <= 50 &&
             data.content is string && data.content.size() <= 50000 &&
             data.status in ['DRAFT', 'UNDER_REVIEW', 'APPROVED', 'PUBLISHED', 'ARCHIVED', 'REVISION_REQUESTED', 'REJECTED'] &&
             data.division in ['children', 'intermediates', 'youth'] &&
             (!('writerName' in data) || (data.writerName is string && data.writerName.size() <= 150)) &&
             (!('categoryName' in data) || (data.categoryName is string && data.categoryName.size() <= 100)) &&
             (!('departmentId' in data) || (data.departmentId is string && data.departmentId.size() <= 64)) &&
             (!('departmentTitle' in data) || (data.departmentTitle is string && data.departmentTitle.size() <= 150)) &&
             (!('dateAmharic' in data) || (data.dateAmharic is string && data.dateAmharic.size() <= 50)) &&
             (!('excerpt' in data) || (data.excerpt is string && data.excerpt.size() <= 500)) &&
             (!('readTime' in data) || (data.readTime is string && data.readTime.size() <= 30)) &&
             (!('version' in data) || (data.version is number)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 30)) &&
             (!('isBookmarked' in data) || (data.isBookmarked is bool)) &&
             (!('isFeatured' in data) || (data.isFeatured is bool)) &&
             (!('approvedBy' in data) || data.approvedBy == null || (data.approvedBy is string && data.approvedBy.size() <= 150)) &&
             (!('approvedDate' in data) || data.approvedDate == null || (data.approvedDate is string && data.approvedDate.size() <= 50)) &&
             (!('reviewerFeedback' in data) || data.reviewerFeedback == null || (data.reviewerFeedback is string && data.reviewerFeedback.size() <= 2000)) &&
             (!('hasPdfAttachment' in data) || (data.hasPdfAttachment is bool)) &&
             (!('pdfFileName' in data) || data.pdfFileName == null || (data.pdfFileName is string && data.pdfFileName.size() <= 255)) &&
             (!('pdfFileSize' in data) || data.pdfFileSize == null || (data.pdfFileSize is string && data.pdfFileSize.size() <= 50)) &&
             (!('pdfLocalPath' in data) || data.pdfLocalPath == null || (data.pdfLocalPath is string && data.pdfLocalPath.size() <= 500)) &&
             (!('pdfUrl' in data) || data.pdfUrl == null || (data.pdfUrl is string && data.pdfUrl.size() <= 1000)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    match /works/{workId} {
      // Anyone can read approved/published works in the public cultural archive.
      // Drafts, reviews, and unapproved works are restricted to author, reviewers, dept manager, or super admin.
      allow get, list: if resource.data.status in ['APPROVED', 'PUBLISHED'] || (
        isSignedIn() && (
          resource.data.writerId == request.auth.uid ||
          isReviewer() ||
          isSuperAdmin() ||
          (('departmentId' in resource.data) && canAuthorizeMembers(resource.data.departmentId))
        )
      );

      // Create: Authenticated users can submit their own works under review or draft
      allow create: if isSignedIn() &&
                    isValidId(workId) &&
                    isValidWork(incoming()) &&
                    incoming().writerId == request.auth.uid &&
                    (incoming().status in ['DRAFT', 'UNDER_REVIEW'] || isAdmin());

      // Update:
      // Authors can update content/title of their own works in draft/under review
      // Reviewers / Dept Managers (within their department only) / Super Admins can review & approve works
      allow update: if isSignedIn() &&
                    isValidId(workId) &&
                    isValidWork(incoming()) &&
                    incoming().id == existing().id &&
                    incoming().writerId == existing().writerId && (
                      isAdmin() ||
                      ((isReviewer() || (('departmentId' in existing()) && canAuthorizeMembers(existing().departmentId) && incoming().departmentId == existing().departmentId)) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewerFeedback', 'approvedBy', 'approvedDate', 'isFeatured', 'version', 'updatedAt'])) ||
                      (isOwner(existing().writerId) && existing().status in ['DRAFT', 'UNDER_REVIEW', 'REVISION_REQUESTED'] &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'excerpt', 'tags', 'hasPdfAttachment', 'pdfFileName', 'pdfFileSize', 'pdfUrl', 'version', 'status', 'division', 'categoryId', 'categoryName', 'updatedAt']) &&
                       incoming().status in ['DRAFT', 'UNDER_REVIEW'])
                    );

      // Delete: Author (if draft), Dept Manager (in own dept), or Super Admin
      allow delete: if isValidId(workId) && (
        isAdmin() ||
        (('departmentId' in resource.data) && canAuthorizeMembers(resource.data.departmentId)) ||
        (isOwner(resource.data.writerId) && resource.data.status == 'DRAFT')
      );
    }

    // 7. Departments collection
    match /departments/{deptId} {
      allow get, list: if true;
      allow create, update, delete: if isSuperAdmin() && isValidId(deptId);
    }

    // 8. Department Memberships (Canonical document ID: {userId}_{departmentId})
    function isValidMembership(data) {
      return data.keys().hasAll(['id', 'userId', 'userEmail', 'userName', 'departmentId', 'role', 'status']) &&
             data.keys().hasOnly([
               'id', 'userId', 'userEmail', 'userName', 'departmentId', 'departmentName',
               'division', 'sundaySchoolId', 'requestedPosition', 'serviceSkills',
               'preferredResponsibilities', 'role', 'canApproveMembers', 'status', 'inviteId',
               'rejectionReason', 'approvedBy', 'approvedByName', 'approvedAt',
               'statusUpdatedAt', 'createdAt'
             ]) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.userEmail is string && data.userEmail.size() <= 150 &&
             data.userName is string && data.userName.size() > 0 && data.userName.size() <= 150 &&
             data.departmentId is string && data.departmentId.size() > 0 && data.departmentId.size() <= 64 &&
             (!('departmentName' in data) || (data.departmentName is string && data.departmentName.size() <= 150)) &&
             (!('division' in data) || data.division in ['children', 'intermediates', 'youth']) &&
             (!('sundaySchoolId' in data) || (data.sundaySchoolId is string && data.sundaySchoolId.size() > 0 && data.sundaySchoolId.size() <= 50)) &&
             (!('requestedPosition' in data) || data.requestedPosition in ['DEPARTMENT_HEAD', 'MIKITIL_HEAD', 'MEMBER']) &&
             (!('serviceSkills' in data) || (data.serviceSkills is list && data.serviceSkills.size() <= 30)) &&
             (!('preferredResponsibilities' in data) || (data.preferredResponsibilities is string && data.preferredResponsibilities.size() <= 500)) &&
             (!('canApproveMembers' in data) || (data.canApproveMembers is bool)) &&
             (!('rejectionReason' in data) || (data.rejectionReason is string && data.rejectionReason.size() <= 1000)) &&
             (!('approvedBy' in data) || (data.approvedBy is string && data.approvedBy.size() <= 128)) &&
             (!('approvedByName' in data) || (data.approvedByName is string && data.approvedByName.size() <= 150)) &&
             (!('approvedAt' in data) || (data.approvedAt is string && data.approvedAt.size() <= 50)) &&
             (!('statusUpdatedAt' in data) || (data.statusUpdatedAt is string && data.statusUpdatedAt.size() <= 50)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!('inviteId' in data) || isValidId(data.inviteId)) &&
             data.role in ['MEMBER', 'CONTRIBUTOR', 'REVIEWER', 'EDITOR', 'ADMIN'] &&
             data.status in ['PENDING', 'APPROVED', 'REJECTED', 'SUSPENDED'];
    }

    function isMatchingActiveInvite(data) {
      return ('inviteId' in data) &&
             isValidId(data.inviteId) &&
             request.auth.token.email != null &&
             exists(/databases/$(database)/documents/department_invites/$(data.inviteId)) &&
             get(/databases/$(database)/documents/department_invites/$(data.inviteId)).data.status == 'ACTIVE' &&
             get(/databases/$(database)/documents/department_invites/$(data.inviteId)).data.emailLower == request.auth.token.email.lower() &&
             get(/databases/$(database)/documents/department_invites/$(data.inviteId)).data.departmentId == data.departmentId &&
             get(/databases/$(database)/documents/department_invites/$(data.inviteId)).data.role == data.role &&
             (
               !('canApproveMembers' in data) ||
               data.canApproveMembers == false ||
               (
                 ('canApproveMembers' in get(/databases/$(database)/documents/department_invites/$(data.inviteId)).data) &&
                 get(/databases/$(database)/documents/department_invites/$(data.inviteId)).data.canApproveMembers == true &&
                 data.canApproveMembers == true
               )
             );
    }

    match /department_memberships/{membershipId} {
      // Read access:
      // - User can read their own membership
      // - Department admin or department member-authorizer can read memberships in their department only
      // - Super admin can read all
      allow get, list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        canAuthorizeMembers(resource.data.departmentId) ||
        isSuperAdmin()
      );

      // Creation:
      // - Authenticated users can submit a PENDING membership for themselves with canonical ID {uid}_{deptId}
      //   and a non-admin role (MEMBER or CONTRIBUTOR) without self-granting approval authority
      // - Invited users can claim an active invite matching their email
      // - Super Admin can provision any membership
      allow create: if isSignedIn() &&
                    isValidId(membershipId) &&
                    isValidMembership(incoming()) && (
                      (
                        incoming().userId == request.auth.uid &&
                        membershipId == request.auth.uid + '_' + incoming().departmentId &&
                        incoming().status == 'PENDING' &&
                        incoming().role in ['MEMBER', 'CONTRIBUTOR'] &&
                        (!('canApproveMembers' in incoming()) || incoming().canApproveMembers == false)
                      ) ||
                      (
                        incoming().userId == request.auth.uid &&
                        membershipId == request.auth.uid + '_' + incoming().departmentId &&
                        incoming().status == 'APPROVED' &&
                        isMatchingActiveInvite(incoming())
                      ) ||
                      isSuperAdmin()
                    );

      // Update:
      // - Pending applicant updating their own submission (cannot elevate status, role, or canApproveMembers)
      // - Invited applicant claiming a valid active invite matching their auth email
      // - Dept Admin or authorized Dept Member-Confirmer can approve/reject/suspend or assign non-admin roles
      //   within their own department ONLY (cannot appoint/remove ADMIN or grant/revoke canApproveMembers)
      // - Super Admin can manage all
      allow update: if isSignedIn() &&
                    isValidId(membershipId) &&
                    isValidMembership(incoming()) && (
                      (
                        isOwner(existing().userId) &&
                        existing().status == 'PENDING' &&
                        incoming().id == existing().id &&
                        incoming().userId == existing().userId &&
                        incoming().departmentId == existing().departmentId &&
                        incoming().status == 'PENDING' &&
                        incoming().role in ['MEMBER', 'CONTRIBUTOR'] &&
                        (!('canApproveMembers' in incoming()) || incoming().canApproveMembers == false)
                      ) ||
                      (
                        isOwner(existing().userId) &&
                        incoming().id == existing().id &&
                        incoming().userId == existing().userId &&
                        incoming().departmentId == existing().departmentId &&
                        incoming().status == 'APPROVED' &&
                        isMatchingActiveInvite(incoming())
                      ) ||
                      (
                        canAuthorizeMembers(existing().departmentId) &&
                        incoming().id == existing().id &&
                        incoming().userId == existing().userId &&
                        incoming().departmentId == existing().departmentId &&
                        existing().role != 'ADMIN' &&
                        incoming().role != 'ADMIN' &&
                        hasUnchangedApprovalAuthority(incoming(), existing())
                      ) ||
                      isSuperAdmin()
                    );

      allow delete: if isSuperAdmin() && isValidId(membershipId);
    }

    // 9. Schedule-based Task Assignments
    function isValidAssignment(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.departmentId is string && data.departmentId.size() <= 64 &&
             data.title is string && data.title.size() <= 250 &&
             data.responsibleLeadId is string && data.responsibleLeadId.size() <= 128 &&
             data.assignedMemberIds is list && data.assignedMemberIds.size() > 0 &&
             data.scheduleProgramId is string && data.scheduleProgramId.size() <= 128 &&
             data.agendaSlotId is string && data.agendaSlotId.size() <= 128 &&
             data.status in ['ASSIGNED', 'ACCEPTED', 'IN_PROGRESS', 'SUBMITTED', 'COMPLETED', 'REVISION_REQUESTED', 'CANCELLED'];
    }

    match /schedule_assignments/{assignmentId} {
      // Read: Dept manager (admin or canApproveMembers), Super Admin, or assigned approved member of the department
      allow get, list: if isSignedIn() && (
        isSuperAdmin() ||
        canAuthorizeMembers(resource.data.departmentId) ||
        (
          isApprovedMember(resource.data.departmentId) &&
          request.auth.uid in resource.data.assignedMemberIds
        )
      );

      // Create: Dept manager (admin or canApproveMembers) in own dept, or Super Admin
      // Must ensure responsibleLeadId is among assignedMemberIds
      allow create: if isSignedIn() &&
                    isValidId(assignmentId) &&
                    isValidAssignment(incoming()) &&
                    (incoming().responsibleLeadId in incoming().assignedMemberIds) &&
                    (canAuthorizeMembers(incoming().departmentId) || isSuperAdmin());

      // Update:
      // - Dept manager / Super Admin can manage assignments within their department (cannot change department)
      // - Assigned approved member can update their progress/submission only:
      //   * cannot change departmentId, scheduleProgramId, agendaSlotId, title, instructions, assignedMemberIds, responsibleLeadId
      //   * cannot mark COMPLETED, CANCELLED, or REVISION_REQUESTED (only Dept manager / Super Admin)
      //   * allowed member statuses: ACCEPTED, IN_PROGRESS, SUBMITTED
      //   * must not be suspended (isApprovedMember check)
      allow update: if isSignedIn() &&
                    isValidId(assignmentId) &&
                    isValidAssignment(incoming()) && (
                      (
                        canAuthorizeMembers(existing().departmentId) &&
                        incoming().departmentId == existing().departmentId &&
                        incoming().id == existing().id &&
                        (incoming().responsibleLeadId in incoming().assignedMemberIds)
                      ) ||
                      isSuperAdmin() ||
                      (
                        isApprovedMember(existing().departmentId) &&
                        request.auth.uid in existing().assignedMemberIds &&
                        incoming().departmentId == existing().departmentId &&
                        incoming().id == existing().id &&
                        incoming().responsibleLeadId == existing().responsibleLeadId &&
                        incoming().assignedMemberIds == existing().assignedMemberIds &&
                        incoming().scheduleProgramId == existing().scheduleProgramId &&
                        incoming().agendaSlotId == existing().agendaSlotId &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'deliverableSubmission', 'individualParticipation', 'updatedAt']) &&
                        incoming().status in ['ACCEPTED', 'IN_PROGRESS', 'SUBMITTED']
                      )
                    );

      allow delete: if isValidId(assignmentId) &&
                    (canAuthorizeMembers(existing().departmentId) || isSuperAdmin());
    }

    // 10. Department Notifications
    match /department_notifications/{notificationId} {
      allow get, list: if isSignedIn() && (
        resource.data.targetUserId == request.auth.uid ||
        (!('targetUserId' in resource.data) && isApprovedMember(resource.data.departmentId)) ||
        (resource.data.targetUserId == null && isApprovedMember(resource.data.departmentId)) ||
        canAuthorizeMembers(resource.data.departmentId) ||
        isSuperAdmin()
      );

      // Create: Signed-in user (for actions like member requests or task submissions) or Dept manager / Super Admin
      allow create: if isSignedIn() &&
                    isValidId(notificationId) &&
                    incoming().departmentId is string &&
                    incoming().title is string &&
                    incoming().title.size() <= 200;

      // Update: Target user can mark isRead; Dept manager or Super Admin can manage
      allow update: if isSignedIn() && isValidId(notificationId) && (
        (
          resource.data.targetUserId == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])
        ) ||
        canAuthorizeMembers(existing().departmentId) ||
        isSuperAdmin()
      );

      allow delete: if isValidId(notificationId) && (
        canAuthorizeMembers(existing().departmentId) ||
        isSuperAdmin()
      );
    }

    // 11. Department Invites / Email Pre-Approvals
    function isValidInvite(data) {
      return data.keys().hasAll(['id', 'emailLower', 'fullName', 'departmentId', 'role', 'status', 'invitedBy']) &&
             data.keys().hasOnly([
               'id', 'emailLower', 'fullName', 'departmentId', 'departmentName',
               'division', 'sundaySchoolId', 'requestedPosition', 'role', 'canApproveMembers',
               'status', 'invitedBy', 'invitedByName', 'createdAt', 'claimedBy', 'claimedAt'
             ]) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.emailLower is string && data.emailLower.size() > 3 && data.emailLower.size() <= 150 &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 150 &&
             data.departmentId is string && data.departmentId.size() > 0 && data.departmentId.size() <= 64 &&
             (!('departmentName' in data) || (data.departmentName is string && data.departmentName.size() <= 150)) &&
             (!('division' in data) || data.division in ['children', 'intermediates', 'youth']) &&
             (!('sundaySchoolId' in data) || (data.sundaySchoolId is string && data.sundaySchoolId.size() > 0 && data.sundaySchoolId.size() <= 50)) &&
             (!('requestedPosition' in data) || data.requestedPosition in ['DEPARTMENT_HEAD', 'MIKITIL_HEAD', 'MEMBER']) &&
             (!('canApproveMembers' in data) || (data.canApproveMembers is bool)) &&
             (!('invitedBy' in data) || (data.invitedBy is string && data.invitedBy.size() <= 128)) &&
             (!('invitedByName' in data) || (data.invitedByName is string && data.invitedByName.size() <= 150)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!('claimedBy' in data) || (data.claimedBy is string && data.claimedBy.size() <= 128)) &&
             (!('claimedAt' in data) || (data.claimedAt is string && data.claimedAt.size() <= 50)) &&
             data.role in ['MEMBER', 'CONTRIBUTOR', 'REVIEWER', 'EDITOR', 'ADMIN'] &&
             data.status in ['ACTIVE', 'CLAIMED', 'CANCELLED'];
    }

    match /department_invites/{inviteId} {
      allow get, list: if isSignedIn() && (
        isSuperAdmin() ||
        canAuthorizeMembers(resource.data.departmentId) ||
        (request.auth.token.email != null && resource.data.emailLower == request.auth.token.email.lower())
      );

      allow create: if isSignedIn() &&
                    isValidId(inviteId) &&
                    isValidInvite(incoming()) &&
                    incoming().status == 'ACTIVE' && (
                      isSuperAdmin() ||
                      (
                        canAuthorizeMembers(incoming().departmentId) &&
                        incoming().role != 'ADMIN' &&
                        (!('canApproveMembers' in incoming()) || incoming().canApproveMembers == false)
                      )
                    );

      allow update: if isSignedIn() &&
                    isValidId(inviteId) &&
                    isValidInvite(incoming()) && (
                      isSuperAdmin() ||
                      (
                        canAuthorizeMembers(existing().departmentId) &&
                        incoming().departmentId == existing().departmentId &&
                        existing().role != 'ADMIN' &&
                        incoming().role != 'ADMIN' &&
                        hasUnchangedApprovalAuthority(incoming(), existing())
                      ) ||
                      (
                        request.auth.token.email != null &&
                        existing().emailLower == request.auth.token.email.lower() &&
                        existing().status == 'ACTIVE' &&
                        incoming().status == 'CLAIMED' &&
                        incoming().claimedBy == request.auth.uid &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'claimedBy', 'claimedAt'])
                      )
                    );

      allow delete: if isValidId(inviteId) && (
        (canAuthorizeMembers(existing().departmentId) && existing().role != 'ADMIN') ||
        isSuperAdmin()
      );
    }

    // 12. Sunday Daily Plan Sheets (Ehud Merha Gibir)
    function isValidDailySheet(data) {
      return data.keys().hasAll([
               'id', 'division', 'monthAmharic', 'dayNumber', 'dateAmharic',
               'mainTopic', 'leader', 'presenterOrTeacher', 'timeAmharic',
               'purpose', 'slots', 'preProgramNeeds'
             ]) &&
             data.keys().hasOnly([
               'id', 'division', 'monthAmharic', 'dayNumber', 'dateAmharic',
               'mainTopic', 'leader', 'presenterOrTeacher', 'timeAmharic',
               'purpose', 'slots', 'preProgramNeeds', 'preProgramChecklistState',
               'squadName', 'updatedAt', 'updatedBy', 'postProgramStats'
             ]) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.division in ['children', 'intermediates', 'youth'] &&
             data.monthAmharic is string && data.monthAmharic.size() > 0 && data.monthAmharic.size() <= 50 &&
             data.dayNumber is int && data.dayNumber >= 1 && data.dayNumber <= 30 &&
             data.dateAmharic is string && data.dateAmharic.size() > 0 && data.dateAmharic.size() <= 100 &&
             data.mainTopic is string && data.mainTopic.size() > 0 && data.mainTopic.size() <= 250 &&
             data.leader is string && data.leader.size() > 0 && data.leader.size() <= 200 &&
             data.presenterOrTeacher is string && data.presenterOrTeacher.size() > 0 && data.presenterOrTeacher.size() <= 200 &&
             data.timeAmharic is string && data.timeAmharic.size() > 0 && data.timeAmharic.size() <= 100 &&
             data.purpose is string && data.purpose.size() <= 1500 &&
             data.slots is list && data.slots.size() <= 30 &&
             data.preProgramNeeds is list && data.preProgramNeeds.size() <= 30 &&
             (!('preProgramChecklistState' in data) || data.preProgramChecklistState is map) &&
             (!('squadName' in data) || (data.squadName is string && data.squadName.size() <= 150)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64)) &&
             (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 150)) &&
             (!('postProgramStats' in data) || data.postProgramStats is map);
    }

    match /sunday_daily_sheets/{sheetId} {
      allow get, list: if true;

      allow create: if isSignedIn() &&
                    isValidId(sheetId) &&
                    isValidDailySheet(incoming()) &&
                    incoming().id == sheetId &&
                    (canAuthorizeMembers('ehud_merha_gibir') || isSuperAdmin());

      allow update: if isSignedIn() &&
                    isValidId(sheetId) &&
                    isValidDailySheet(incoming()) &&
                    incoming().id == existing().id && (
                      canAuthorizeMembers('ehud_merha_gibir') ||
                      isSuperAdmin() ||
                      (
                        isApprovedMember('ehud_merha_gibir') &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['preProgramChecklistState', 'updatedAt', 'updatedBy'])
                      )
                    );

      allow delete: if isValidId(sheetId) &&
                    (canAuthorizeMembers('ehud_merha_gibir') || isSuperAdmin());
    }

    // 13. Ehud Merha Gibir: Program Planning
    function isValidEhudPlan(data) {
      return data.keys().hasAll([
               'id', 'departmentId', 'division', 'title', 'monthAmharic',
               'targetDateAmharic', 'goal', 'resourcesNeeded', 'status',
               'createdBy', 'createdByName', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'departmentId', 'division', 'planScope', 'title', 'monthAmharic',
               'targetDateAmharic', 'squadName', 'presenterName', 'scriptureRef',
               'goal', 'resourcesNeeded', 'status', 'createdBy', 'createdByName',
               'createdAt', 'updatedAt'
             ]) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.departmentId == 'ehud_merha_gibir' &&
             data.division in ['children', 'intermediates', 'youth'] &&
             (!('planScope' in data) || data.planScope in ['DAILY', 'WEEKLY', 'YEARLY']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 250 &&
             data.monthAmharic is string && data.monthAmharic.size() > 0 && data.monthAmharic.size() <= 50 &&
             data.targetDateAmharic is string && data.targetDateAmharic.size() > 0 && data.targetDateAmharic.size() <= 100 &&
             (!('squadName' in data) || (data.squadName is string && data.squadName.size() <= 150)) &&
             (!('presenterName' in data) || (data.presenterName is string && data.presenterName.size() <= 150)) &&
             (!('scriptureRef' in data) || (data.scriptureRef is string && data.scriptureRef.size() <= 150)) &&
             data.goal is string && data.goal.size() <= 1500 &&
             data.resourcesNeeded is list && data.resourcesNeeded.size() <= 30 &&
             (data.resourcesNeeded.size() == 0 || data.resourcesNeeded[0] is string) &&
             data.status in ['DRAFT', 'READY', 'SCHEDULED'] &&
             data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() <= 128 &&
             data.createdByName is string && data.createdByName.size() > 0 && data.createdByName.size() <= 150 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    match /ehud_program_plans/{planId} {
      allow get: if isValidId(planId) && resource.data.departmentId == 'ehud_merha_gibir';
      allow list: if resource.data.departmentId == 'ehud_merha_gibir';

      allow create: if isSignedIn() &&
                    isValidId(planId) &&
                    isValidEhudPlan(incoming()) &&
                    incoming().id == planId &&
                    incoming().createdBy == request.auth.uid &&
                    (isApprovedMember('ehud_merha_gibir') || canAuthorizeMembers('ehud_merha_gibir') || isSuperAdmin());

      allow update: if isSignedIn() &&
                    isValidId(planId) &&
                    isValidEhudPlan(incoming()) &&
                    incoming().id == existing().id &&
                    incoming().departmentId == existing().departmentId &&
                    incoming().createdBy == existing().createdBy &&
                    incoming().createdAt == existing().createdAt && (
                      isSuperAdmin() ||
                      canAuthorizeMembers('ehud_merha_gibir') ||
                      (
                        isOwner(existing().createdBy) &&
                        isApprovedMember('ehud_merha_gibir') &&
                        incoming().diff(existing()).affectedKeys().hasOnly([
                          'division', 'planScope', 'title', 'monthAmharic', 'targetDateAmharic',
                          'squadName', 'presenterName', 'scriptureRef', 'goal',
                          'resourcesNeeded', 'status', 'updatedAt'
                        ])
                      )
                    );

      allow delete: if isSignedIn() &&
                    isValidId(planId) && (
                      isOwner(existing().createdBy) ||
                      canAuthorizeMembers('ehud_merha_gibir') ||
                      isSuperAdmin()
                    );
    }

    // 14. Ehud Merha Gibir: Program Following & Check-ins
    function isValidEhudFollowUp(data) {
      return data.keys().hasAll([
               'id', 'departmentId', 'division', 'programSheetId', 'programTitle',
               'programDateAmharic', 'attendanceCount', 'punctualityStatus',
               'readinessScore', 'followUpStatus', 'observations', 'actionItems',
               'recordedBy', 'recordedByName', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'departmentId', 'division', 'planScope', 'programSheetId', 'programTitle',
               'programDateAmharic', 'attendanceCount', 'punctualityStatus',
               'readinessScore', 'followUpStatus', 'observations', 'actionItems',
               'recordedBy', 'recordedByName', 'createdAt', 'updatedAt'
             ]) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.departmentId == 'ehud_merha_gibir' &&
             data.division in ['children', 'intermediates', 'youth'] &&
             (!('planScope' in data) || data.planScope in ['DAILY', 'WEEKLY', 'YEARLY']) &&
             data.programSheetId is string && data.programSheetId.size() > 0 && data.programSheetId.size() <= 128 &&
             data.programTitle is string && data.programTitle.size() > 0 && data.programTitle.size() <= 250 &&
             data.programDateAmharic is string && data.programDateAmharic.size() > 0 && data.programDateAmharic.size() <= 100 &&
             data.attendanceCount is number && data.attendanceCount >= 0 && data.attendanceCount <= 10000 &&
             data.punctualityStatus in ['ON_TIME', 'SLIGHT_DELAY', 'DELAYED'] &&
             data.readinessScore is number && data.readinessScore >= 0 && data.readinessScore <= 100 &&
             data.followUpStatus in ['OPEN', 'IN_PROGRESS', 'RESOLVED'] &&
             data.observations is string && data.observations.size() <= 2000 &&
             data.actionItems is string && data.actionItems.size() <= 1500 &&
             data.recordedBy is string && data.recordedBy.size() > 0 && data.recordedBy.size() <= 128 &&
             data.recordedByName is string && data.recordedByName.size() > 0 && data.recordedByName.size() <= 150 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    match /ehud_followups/{followupId} {
      allow get: if isValidId(followupId) && resource.data.departmentId == 'ehud_merha_gibir';
      allow list: if resource.data.departmentId == 'ehud_merha_gibir';

      allow create: if isSignedIn() &&
                    isValidId(followupId) &&
                    isValidEhudFollowUp(incoming()) &&
                    incoming().id == followupId &&
                    incoming().recordedBy == request.auth.uid &&
                    (isApprovedMember('ehud_merha_gibir') || canAuthorizeMembers('ehud_merha_gibir') || isSuperAdmin());

      allow update: if isSignedIn() &&
                    isValidId(followupId) &&
                    isValidEhudFollowUp(incoming()) &&
                    incoming().id == existing().id &&
                    incoming().departmentId == existing().departmentId &&
                    incoming().recordedBy == existing().recordedBy &&
                    incoming().createdAt == existing().createdAt && (
                      isSuperAdmin() ||
                      canAuthorizeMembers('ehud_merha_gibir') ||
                      (
                        isApprovedMember('ehud_merha_gibir') &&
                        incoming().diff(existing()).affectedKeys().hasOnly([
                          'planScope', 'attendanceCount', 'punctualityStatus', 'readinessScore',
                          'followUpStatus', 'observations', 'actionItems', 'updatedAt'
                        ])
                      )
                    );

      allow delete: if isSignedIn() &&
                    isValidId(followupId) && (
                      isOwner(existing().recordedBy) ||
                      canAuthorizeMembers('ehud_merha_gibir') ||
                      isSuperAdmin()
                    );
    }

    // 15. Ehud Merha Gibir: Program Ratings
    function isValidRatingScore(val) {
      return val is number && val >= 1 && val <= 5;
    }

    function isValidEhudRating(data) {
      return data.keys().hasAll([
               'id', 'departmentId', 'division', 'programSheetId', 'programTitle',
               'programDateAmharic', 'overallRating', 'spiritualDepthRating',
               'timeManagementRating', 'organizationRating', 'engagementRating',
               'raterId', 'raterName', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'departmentId', 'division', 'planScope', 'programSheetId', 'programTitle',
               'programDateAmharic', 'overallRating', 'spiritualDepthRating',
               'timeManagementRating', 'organizationRating', 'engagementRating',
               'strengths', 'improvements', 'raterId', 'raterName', 'createdAt', 'updatedAt'
             ]) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.departmentId == 'ehud_merha_gibir' &&
             data.division in ['children', 'intermediates', 'youth'] &&
             (!('planScope' in data) || data.planScope in ['DAILY', 'WEEKLY', 'YEARLY']) &&
             data.programSheetId is string && data.programSheetId.size() > 0 && data.programSheetId.size() <= 128 &&
             data.programTitle is string && data.programTitle.size() > 0 && data.programTitle.size() <= 250 &&
             data.programDateAmharic is string && data.programDateAmharic.size() > 0 && data.programDateAmharic.size() <= 100 &&
             isValidRatingScore(data.overallRating) &&
             isValidRatingScore(data.spiritualDepthRating) &&
             isValidRatingScore(data.timeManagementRating) &&
             isValidRatingScore(data.organizationRating) &&
             isValidRatingScore(data.engagementRating) &&
             (!('strengths' in data) || (data.strengths is string && data.strengths.size() <= 1000)) &&
             (!('improvements' in data) || (data.improvements is string && data.improvements.size() <= 1000)) &&
             data.raterId is string && data.raterId.size() > 0 && data.raterId.size() <= 128 &&
             data.raterName is string && data.raterName.size() > 0 && data.raterName.size() <= 150 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    match /ehud_program_ratings/{ratingId} {
      allow get: if isValidId(ratingId) && resource.data.departmentId == 'ehud_merha_gibir';
      allow list: if resource.data.departmentId == 'ehud_merha_gibir';

      allow create: if isSignedIn() &&
                    isValidId(ratingId) &&
                    isValidEhudRating(incoming()) &&
                    incoming().id == ratingId &&
                    incoming().raterId == request.auth.uid;

      allow update: if isSignedIn() &&
                    isValidId(ratingId) &&
                    isValidEhudRating(incoming()) &&
                    incoming().id == existing().id &&
                    incoming().departmentId == existing().departmentId &&
                    incoming().raterId == existing().raterId &&
                    incoming().createdAt == existing().createdAt && (
                      isSuperAdmin() ||
                      canAuthorizeMembers('ehud_merha_gibir') ||
                      (
                        isOwner(existing().raterId) &&
                        incoming().diff(existing()).affectedKeys().hasOnly([
                          'planScope', 'overallRating', 'spiritualDepthRating', 'timeManagementRating',
                          'organizationRating', 'engagementRating', 'strengths',
                          'improvements', 'updatedAt'
                        ])
                      )
                    );

      allow delete: if isSignedIn() &&
                    isValidId(ratingId) && (
                      isOwner(existing().raterId) ||
                      canAuthorizeMembers('ehud_merha_gibir') ||
                      isSuperAdmin()
                    );
    }
  }
}

