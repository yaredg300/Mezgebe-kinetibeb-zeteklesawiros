          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Program title",
          "maxLength": 200
        },
        "recurrence": {
          "type": "string",
          "description": "Recurrence cycle",
          "enum": ["WEEKLY", "MONTHLY", "YEARLY", "SPECIAL"]
        },
        "dateAmharic": {
          "type": "string",
          "description": "Ethiopic date description",
          "maxLength": 100
        },
        "timeAmharic": {
          "type": "string",
          "description": "Ethiopic time description",
          "maxLength": 100
        },
        "location": {
          "type": "string",
          "description": "Church venue or hall name",
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "description": "Program type category",
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "description": "Event detailed description",
          "maxLength": 2000
        },
        "organizer": {
          "type": "string",
          "description": "Organizing body",
          "maxLength": 150
        },
        "division": {
          "type": "string",
          "description": "Target Sunday school division",
          "maxLength": 50
        },
        "assignments": {
          "type": "array",
          "description": "List of program duty assignments"
        }
      },
      "required": ["id", "title", "recurrence", "location", "organizer"]
    },
    "userProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile and preferences",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "User UID matching auth.uid",
          "maxLength": 128
        },
        "fullName": {
          "type": "string",
          "description": "Full name",
          "maxLength": 150
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 150
        },
        "role": {
          "type": "string",
          "description": "Assigned role",
          "enum": ["GUEST", "MEMBER", "CREATOR", "REVIEWER", "ADMIN"]
        },
        "department": {
          "type": "string",
          "description": "Department affiliation",
          "maxLength": 150
        },
        "departmentId": {
          "type": "string",
          "description": "Target department identifier",
          "maxLength": 64
        },
        "sundaySchoolId": {
          "type": "string",
          "description": "Sunday School Identification Number",
          "maxLength": 50
        },
        "requestedPosition": {
          "type": "string",
          "description": "Requested role division for Sunday Program department",
          "enum": ["DEPARTMENT_HEAD", "MIKITIL_HEAD", "MEMBER"]
        },
        "joinedDate": {
          "type": "string",
          "description": "Membership join date",
          "maxLength": 50
        },
        "bookmarks": {
          "type": "array",
          "description": "Array of saved workIds"
        }
      },
      "required": ["id", "fullName", "email", "role"]
    },
    "admin": {
      "title": "Admin",
      "description": "Authoritative list of church administrators",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Admin email",
          "maxLength": 150
        },
        "role": {
          "type": "string",
          "description": "Admin level designation",
          "maxLength": 50
        }
      },
      "required": ["email", "role"]
    },
    "departmentMembership": {
      "title": "DepartmentMembership",
      "description": "User membership request and approval record for a specific department",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique key in format userId_departmentId",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Auth UID of the applicant",
          "maxLength": 128
        },
        "userEmail": {
          "type": "string",
          "description": "Applicant email address",
          "maxLength": 150
        },
        "userName": {
          "type": "string",
          "description": "Applicant full name",
          "maxLength": 150
        },
        "departmentId": {
          "type": "string",
          "description": "ID of the target department",
          "maxLength": 64
        },
        "departmentName": {
          "type": "string",
          "description": "Title of the target department",
          "maxLength": 150
        },
        "division": {
          "type": "string",
          "description": "Sunday school age division",
          "enum": ["children", "intermediates", "youth"]
        },
        "sundaySchoolId": {
          "type": "string",
          "description": "Sunday School Identification Number",
          "maxLength": 50
        },
        "requestedPosition": {
          "type": "string",
          "description": "Requested role division for Sunday Program department",
          "enum": ["DEPARTMENT_HEAD", "MIKITIL_HEAD", "MEMBER"]
        },
        "serviceSkills": {
          "type": "array",
          "description": "List of service skills"
        },
        "preferredResponsibilities": {
          "type": "string",
          "description": "Preferred service responsibilities",
          "maxLength": 500
        },
        "role": {
          "type": "string",
          "description": "Department assigned role",
          "enum": ["MEMBER", "CONTRIBUTOR", "REVIEWER", "EDITOR", "ADMIN"]
        },
        "canApproveMembers": {
          "type": "boolean",
          "description": "Department-scoped authority to confirm and authorize members of this department only"
        },
        "status": {
          "type": "string",
          "description": "Approval status",
          "enum": ["PENDING", "APPROVED", "REJECTED", "SUSPENDED"]
        },
        "rejectionReason": {
          "type": "string",
          "description": "Reason provided by administrator if rejected",
          "maxLength": 1000
        },
        "approvedBy": {
          "type": "string",
          "description": "UID of approving administrator",
          "maxLength": 128
        },
        "approvedByName": {
          "type": "string",
          "description": "Full name of approving administrator",
          "maxLength": 150
        },
        "approvedAt": {
          "type": "string",
          "description": "Timestamp of approval",
          "maxLength": 50
        },
        "statusUpdatedAt": {
          "type": "string",
          "description": "Timestamp of last status update",
          "maxLength": 50
        },
        "inviteId": {
          "type": "string",
          "description": "Optional pre-approval invite ID used to claim membership",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "description": "Request creation timestamp",
          "maxLength": 50
        }
      },
      "required": ["id", "userId", "userEmail", "userName", "departmentId", "role", "status"]
    },
    "departmentInvite": {
      "title": "DepartmentInvite",
