          "maxLength": 150
        },
        "fullName": {
          "type": "string",
          "description": "Full name of the invited member",
          "maxLength": 150
        },
        "departmentId": {
          "type": "string",
          "description": "Department ID",
          "maxLength": 64
        },
        "departmentName": {
          "type": "string",
          "description": "Department Amharic title",
          "maxLength": 150
        },
        "division": {
          "type": "string",
          "description": "Age division",
          "enum": ["children", "intermediates", "youth"]
        },
        "sundaySchoolId": {
          "type": "string",
          "description": "Sunday School Identification Number",
          "maxLength": 50
        },
        "requestedPosition": {
          "type": "string",
          "description": "Department position",
          "enum": ["DEPARTMENT_HEAD", "MIKITIL_HEAD", "MEMBER"]
        },
        "role": {
          "type": "string",
          "description": "Pre-approved role",
          "enum": ["MEMBER", "CONTRIBUTOR", "REVIEWER", "EDITOR", "ADMIN"]
        },
        "canApproveMembers": {
          "type": "boolean",
